# Postgres connection string. When you attach a Postgres database to your
# Vercel project (Storage tab), Vercel sets this automatically — for local
# dev, copy it from the Vercel dashboard or run `vercel env pull`.
POSTGRES_URL=

# Random secret used to sign session cookies. Generate one with:
#   openssl rand -base64 32
SESSION_SECRET=

# Optional: without this, verification/password-reset emails are logged to
# the server console instead of sent. Get a key at https://resend.com.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Optional: without this, agent actions return canned responses instead of
# real Claude-generated ones. Get a key at https://console.anthropic.com.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
